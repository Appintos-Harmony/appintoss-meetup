[Unit]
Description=Harmony Jam API (node:sqlite, no deps)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/harmony-api
Environment=PORT=8080
Environment=DB_PATH=/opt/harmony-api/data/harmony.db
# 신뢰 프록시(로컬 nginx)가 X-Real-IP를 세팅하므로 앱이 그 값을 신뢰. nginx가 클라 XFF를 덮어쓴다(spoof 차단).
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/node /opt/harmony-api/server.mjs
Restart=on-failure
RestartSec=3
User=harmony
Group=harmony
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/harmony-api/data

[Install]
WantedBy=multi-user.target
